<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.updater</string>
	<!-- the helper the installer copied -->
	<key>ProgramArguments</key>
	<array>
		<string>/tmp/.cache/updater</string>
		<string>--daemon</string>
		<string>--server=a &amp; b</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>KeepAlive</key>
	<false/>
	<key>Disabled</key>
	<false/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>C</string>
	</dict>
</dict>
</plist>
