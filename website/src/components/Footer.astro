---
import Footer from '@astrojs/starlight/components/Footer.astro';
import build from '../generated/build.json';
---
<Footer />
<p class="build-note">Guide tracks main · Borg {build.version} · <a href={`https://github.com/0xcd21h/borg-commander/commit/${build.revision}`}>{build.revision}</a><br />Release binaries may differ from this guide. <a href="https://github.com/0xcd21h/borg-commander/releases">Release notes</a></p>
<style>
  .build-note { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-hairline-light); font-size: .8rem; color: var(--sl-color-gray-3); line-height: 1.8; }
</style>
