class BorgCommander < Formula
  desc "Two-panel terminal file commander with a real shell behind it"
  homepage "https://github.com/0xcd21h/borg-commander"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/0xcd21h/borg-commander/releases/download/v@VERSION@/borg-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_ARM@"
    end
    on_intel do
      url "https://github.com/0xcd21h/borg-commander/releases/download/v@VERSION@/borg-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_INTEL@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/0xcd21h/borg-commander/releases/download/v@VERSION@/borg-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "https://github.com/0xcd21h/borg-commander/releases/download/v@VERSION@/borg-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_INTEL@"
    end
  end

  def install
    bin.install "borg"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/borg --version")
  end
end
